# dunst — NightDE pop-up notifications (Kanagawa, matches the eww sidebar)

[global]
    monitor = 0
    follow = none
    layer = overlay

    # Position: top-right, just below Waybar
    origin = top-right
    offset = (12, 50)
    width = 340
    height = (0, 300)
    notification_limit = 5
    gap_size = 8

    # Look
    font = Rubik 11
    corner_radius = 16
    frame_width = 0
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    transparency = 0
    progress_bar = true
    progress_bar_corner_radius = 4

    # Text
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    show_age_threshold = 60
    stack_duplicates = true
    show_indicators = no

    # Icons
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    enable_recursive_icon_lookup = true

    # History (the sidebar shows this)
    sticky_history = yes
    history_length = 50

    # Mouse
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#121212d9"
    foreground = "#C8C093"
    highlight = "#E46876"
    timeout = 4

[urgency_normal]
    background = "#121212d9"
    foreground = "#DCD7BA"
    highlight = "#E46876"
    timeout = 6

[urgency_critical]
    background = "#121212e6"
    foreground = "#DCD7BA"
    highlight = "#E82424"
    frame_color = "#E82424"
    timeout = 0
