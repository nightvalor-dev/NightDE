{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 6,
  "control-center-margin-bottom": 6,
  "control-center-margin-right": 6,
  "control-center-margin-left": 0,
  "control-center-width": 400,
  "fit-to-screen": true,
  "notification-window-width": 380,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "buttons-grid": {
      "actions": [
        {
          "label": "\udb81\udda9",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = enabled ] && echo true || echo false'"
        },
        {
          "label": "\udb80\udcaf",
          "type": "toggle",
          "active": false,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
        },
        {
          "label": "\udb83\ude51",
          "command": "sh -c 'swaync-client -cp; sleep 0.3; grim -g \"$(slurp)\" - | wl-copy'"
        },
        {
          "label": "\udb80\ude0a",
          "command": "sh -c 'swaync-client -cp; sleep 0.3; hyprpicker -a'"
        },
        {
          "label": "\udb80\udf3e",
          "command": "sh -c 'swaync-client -cp; sleep 0.3; hyprlock -c $HOME/.config/hypr/hyprlock/hyprlock.conf'"
        },
        {
          "label": "\udb81\udc25",
          "command": "sh -c 'swaync-client -cp; sleep 0.3; $HOME/.config/waybar/menus/power.sh'"
        }
      ]
    },
    "volume": {
      "label": "\udb81\udd7e",
      "show-per-app": false
    },
    "backlight": {
      "label": "\uf0eb",
      "device": "intel_backlight"
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 12
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do not disturb"
    }
  }
}
