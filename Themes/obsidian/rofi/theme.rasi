/* Themes/obsidian/rofi/theme.rasi — included via ~/.config/rofi/themes/theme.rasi */

* {
    bg:      #121214E6;   /* dark, semi-transparent for blur to show through */
    bg-alt:  #1c1c20CC;
    fg:      #E4E4E7;
    accent:  #6E8CAEF2;
    border:  #ffffff1A;

    background-color: transparent;
    text-color:        @fg;
}

window {
    width:              600px;
    height:             500px;
    background-color:   @bg;
    border:             1px;
    border-color:       @border;
    border-radius:      12px;
    padding:            12px;
}

inputbar {
    background-color:   @bg-alt;
    border-radius:       8px;
    padding:            10px 12px;
    children:            [ entry ];
}

entry {
    placeholder:        "Search…";
    placeholder-color:  #8B8B93;
}

listview {
    background-color:   transparent;
    margin:              10px 0 0;
    lines:               8;
    spacing:             4px;
}

element {
    padding:        8px 10px;
    border-radius:  8px;
}

element selected {
    background-color:  @accent;
    text-color:         @fg;
}
